        "jsCode": "// 入力エラー: LLM を呼ばずに 400 を返す。\nconst j = $input.first().json;\nconst error = { stage: 'input', reason: j.inputErrors.join(' / ') };\nreturn [{\n  json: {\n    httpStatus: 400,\n    error,\n    response: { status: 'input_error', error },\n    logContext: { receivedAt: j.receivedAt, attempts: 0 },\n  },\n}];\n"
      },
