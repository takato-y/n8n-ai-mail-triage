    {
      "parameters": {
        "jsCode": "// 記録用の行データ（表計算シート・データテーブルの1行に相当）と応答を作る。\nconst j = $input.first().json;\nconst x = j.extracted;\nconst record = {\n  received_at: j.receivedAt,\n  category: x.category,\n  route: j.route,\n  urgency: x.urgency,\n  company: x.company || '',\n  contact_name: x.contact_name || '',\n  summary: x.summary,\n  from: j.email.from,\n  subject: j.email.subject,\n  status: '未対応',\n};\nreturn [{\n  json: {\n    httpStatus: 200,\n    response: {\n      status: 'ok',\n      category: x.category,\n      extracted: x,\n      route: j.route,\n      record,\n      replyDraft: j.replyDraft,\n      attempts: j.attempt,\n    },\n  },\n}];\n"
